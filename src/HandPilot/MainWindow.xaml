<Window x:Class="HandPilot.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf" Title="HandPilot · Movement" Width="1040" Height="800" MinWidth="760" MinHeight="620" Background="#101522" Foreground="#EDF3FF">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="16,9"/><Setter Property="Margin" Value="0,0,10,0"/><Setter Property="Background" Value="#243248"/><Setter Property="Foreground" Value="#EDF3FF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Style.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></Style.Triggers>
  </Style>
 </Window.Resources>
 <Grid Margin="20">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14">
   <TextBlock DockPanel.Dock="Right" Text="MOVEMENT MILESTONE" Foreground="#70E0C4" FontSize="11" VerticalAlignment="Center"/>
   <TextBlock Text="HandPilot" FontSize="26" FontWeight="SemiBold"/>
  </DockPanel>
  <StackPanel Grid.Row="1">
   <WrapPanel Margin="0,0,0,10">
    <Button x:Name="ControlButton" Content="Start movement" Background="#70E0C4" Foreground="#101522" Click="ToggleControl" IsEnabled="False"/>
    <Button x:Name="CalibrateButton" Content="Quick setup" Click="BeginCalibration" IsEnabled="False"/>
    <Button x:Name="TrialButton" Content="Check movement" Click="RunMovementTrial" IsEnabled="False"/>
   </WrapPanel>
   <TextBlock x:Name="TrackingStatus" Text="Starting camera setup…" FontSize="15" FontWeight="SemiBold"/>
   <TextBlock x:Name="ReachStatus" Text="Choose your camera below, start preview, then use Quick setup." Foreground="#A6B3CC" TextWrapping="Wrap" Margin="0,4,0,0"/>
   <TextBlock x:Name="ActionMessage" Text="Movement only · clicking and scrolling are paused during this milestone." Foreground="#A6B3CC" TextWrapping="Wrap" Margin="0,4,0,12"/>
  </StackPanel>
  <Border Grid.Row="2" x:Name="CalibrationPanel" Visibility="Collapsed" Background="#213146" CornerRadius="8" Padding="14" Margin="0,0,0,10">
   <StackPanel>
    <TextBlock x:Name="CalibrationPrompt" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ProgressBar x:Name="CalibrationProgress" Minimum="0" Maximum="1" Height="8" Foreground="#70E0C4" Background="#101522" BorderThickness="0" Margin="0,0,0,10"/>
    <DockPanel><Button DockPanel.Dock="Right" Content="Cancel setup" Click="CancelCalibration" Margin="12,0,0,0"/><TextBlock x:Name="CalibrationHint" Text="Saves automatically. Small hand tremors are okay." TextWrapping="Wrap" VerticalAlignment="Center" Foreground="#A6B3CC"/></DockPanel>
   </StackPanel>
  </Border>
  <wv:WebView2 Grid.Row="3" x:Name="CameraView" DefaultBackgroundColor="#192235"/>
  <TextBlock Grid.Row="4" Text="Ctrl + Alt + Space pauses immediately · Keep your whole hand visible · Tracking stays on this device" Foreground="#A6B3CC" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>
 </Grid>
</Window>
